# Com-Writer 环境变量模板
# 复制此文件为 .env 并填入真实密钥
# .env 文件不会提交到 Git

# 工作目录名（按企业/部门组织，对应代码中的 workspace 目录）
COM_WRITER_WORKSPACE=workspace

ZHIPU_API_KEY=your_zhipu_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
INTRANET_TOKEN=your_intranet_token_here
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key_here
